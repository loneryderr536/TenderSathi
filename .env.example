# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=anthropic          # or openai
LLM_API_KEY=your-key-here
# Per-agent models (defaults shown). OpenAI users must set all six.
# READER_MODEL=claude-haiku-5-5
# ELIGIBILITY_MODEL=claude-haiku-5-5
# CHECKLIST_MODEL=claude-haiku-5-5
# DRAFTER_MODEL=claude-sonnet-5-5
# REVIEWER_MODEL=claude-sonnet-5-5
# TRACKER_MODEL=claude-sonnet-5-5
STORAGE_DIR=../storage
# CORS_ORIGINS=http://192.168.1.20:5173   # extra websites allowed to call the API (default: local Vite ports)
