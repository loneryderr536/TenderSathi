# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=your-groq-key-here
# Per-agent Groq models (defaults shown).
# READER_MODEL=openai/gpt-oss-120b
# ELIGIBILITY_MODEL=qwen/qwen3.8-27b
# CHECKLIST_MODEL=openai/gpt-oss-120b
# DRAFTER_MODEL=openai/gpt-oss-120b
# REVIEWER_MODEL=openai/gpt-oss-120b
# TRACKER_MODEL=openai/gpt-oss-120b
STORAGE_DIR=../storage
# CORS_ORIGINS=http://192.168.1.20:5173   # extra websites allowed to call the API (default: local Vite ports)
# SCOUT_INTERVAL_SECONDS=300   # the Scout sweeps the tender portals on its own this often (default: only when asked)
# FEED_PATH=../data/feed/portal_feed.json   # the portal feed the Scout reads
# CORS_ORIGIN_REGEX=https://tendersathi(-[a-z0-9-]+)?\.vercel\.app   # allow every Vercel preview address too
